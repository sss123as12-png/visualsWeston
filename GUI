-- Загрузка оптимизированной версии Fluent, совместимой с Xeno
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- Настройки основного окна
local Window = Fluent:CreateWindow({
    Title = "Universal Visuals HUB | MM2, JJS, TSB",
    SubTitle = "by AI Collaborator",
    TabWidth = 160,
    Size = UDim2.fromOffset(580, 460),
    Acrylic = false, -- СТРОГО FALSE ДЛЯ XENO (предотвращает краш инжектора)
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.Z -- Сворачивание меню на кнопку Z
})

-- Создание вкладок меню
local Tabs = {
    Main = Window:AddTab({ Title = "Главная", Icon = "home" }),
    Visuals = Window:AddTab({ Title = "Визуалы (ESP)", Icon = "eye" }),
    Optimization = Window:AddTab({ Title = "Оптимизация", Icon = "zap" }),
    Settings = Window:AddTab({ Title = "Настройки", Icon = "settings" })
}

-- Уведомление о успешном запуске скрипта
Fluent:Notify({
    Title = "Visuals HUB Launched",
    Content = "Меню успешно загружено на Xeno. Кнопка сворачивания: [ Z ]",
    Duration = 5
})

-- Вкладка: Главная
Tabs.Main:AddParagraph({
    Title = "Добро пожаловать!",
    Content = "Скрипт оптимизирован под Xeno.\nТекущие цели: MM2, ТСБ, ЖЖС."
})

-- Вкладка: Оптимизация (Готовим кнопки под будущий функционал)
local ToggleTextures = Tabs.Optimization:AddToggle("ToggleTextures", {Title = "Отключить текстуры (Серый мир)", Default = false})
local ToggleAccessories = Tabs.Optimization:AddToggle("ToggleAccessories", {Title = "Убрать аксессуары игроков", Default = false})

-- Вкладка: Настройки (Кнопка полного закрытия скрипта)
Tabs.Settings:AddButton({
    Title = "Полностью закрыть скрипт",
    Description = "Удаляет меню",
    Callback = function()
        Window:Destroy()
    end
})

-- Автоматический выбор первой вкладки при старте
Window:SelectTab(1)
